# =========================================================

# EVIDENCE TRACEABILITY

# =========================================================

st.divider()

st.subheader(

    "🔗 Claim → Evidence → Source"

)

if ledger and ledger.get("claims"):

    for claim in ledger["claims"]:

        claim_id = claim.get(

            "claim_id",

            "Unknown",

        )

        claim_text = claim.get(

            "claim",

            "No claim text",

        )

        with st.expander(

            f"{claim_id} — {claim_text}"

        ):

            claim_confidence = claim.get(

                "claim_confidence",

                0.0,

            )

            claim_status = claim.get(

                "status",

                "unknown",

            )

            st.write(

                f"**Claim confidence:** "

                f"{claim_confidence:.2f}"

            )

            st.write(

                f"**Status:** "

                f"{claim_status}"

            )

            evidence_items = claim.get(

                "evidence",

                [],

            )

            if not evidence_items:

                st.warning(

                    "No supporting evidence found."

                )

                continue

            for evidence in evidence_items:

                st.markdown(

                    f"### {evidence.get('evidence_id', 'EVIDENCE')}"

                )

                st.write(

                    f"**Source:** "

                    f"{evidence.get('source_title', 'Unknown')}"

                )

                st.write(

                    f"**Source type:** "

                    f"{evidence.get('source_type', 'Unknown')}"

                )

                evidence_confidence = evidence.get(

                    "evidence_confidence",

                    0.0,

                )

                st.write(

                    f"**Evidence confidence:** "

                    f"{evidence_confidence:.2f}"

                )

                st.write(

                    "**Claim extracted from source:**"

                )

                st.write(

                    evidence.get(

                        "claim_from_source",

                        "",

                    )

                )

                st.write(

                    "**Supporting text:**"

                )

                st.write(

                    evidence.get(

                        "supporting_text",

                        "",

                    )

                )

                source_url = evidence.get(

                    "source_url"

                )

                if source_url:

                    st.markdown(

                        f"[🌐 Open source]({source_url})"

                    )

                st.divider()

else:

